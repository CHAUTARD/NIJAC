# Copier ce fichier en .env et remplir les valeurs encodées (ROT47).
# Ne jamais versionner .env (voir .gitignore).
#
# Pour encoder une valeur (ROT47 est son propre inverse) :
#   php -r "function rot47(\$s){...} echo rot47('votre_valeur');"
# Utiliser le script utilitaire : php tools/rot47.php votre_valeur

# Base de données (production uniquement — ignoré en développement)
DB_NAME=
DB_USER=
DB_PASS=

# API FFTT
FFTT_SERIAL=
FFTT_PASSWORD=
